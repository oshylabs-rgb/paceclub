# PaceClub — environment variables
# Copy this file to .env.local and fill in real values before running pnpm dev.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Stripe (LIVE mode from day one — no test detour) ---
# Only needed at Phase 4 onwards. Leave blank during Phase 3 waitlist.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_YEARLY=price_...

# --- Strava OAuth ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://paceclub.run/api/strava/callback

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@paceclub.run

# --- App ---
NEXT_PUBLIC_APP_URL=https://paceclub.run
NEXT_PUBLIC_ENABLE_WAITLIST=true
